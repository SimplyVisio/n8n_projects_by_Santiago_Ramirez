# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=20.0           # Seconds before an LLM call is aborted
OPENAI_MAX_RETRIES=2          # Exponential-backoff retries on transient errors

# ── Supabase / PostgreSQL ───────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql+asyncpg://user:password@host:port/dbname
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_password

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=604800        # Sliding window reset on each cache hit (7 days)
REDIS_MAX_LIFETIME_SECONDS=2592000  # Absolute eviction ceiling regardless of hits (30 days). Set to 0 to disable.

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=5        # Max reasoning iterations before giving up
IDEMPOTENCY_WINDOW_SECONDS=300  # Window to deduplicate n8n retries (5 minutes)

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
